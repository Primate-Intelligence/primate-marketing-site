---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  /** Path for the canonical URL, e.g. "/pricing". Defaults to current path. */
  canonicalPath?: string;
  /** OG type override (website | article). */
  ogType?: string;
  /** Absolute or site-relative OG image. */
  ogImage?: string;
  /** Extra JSON-LD objects to embed (Organization is always included). */
  jsonLd?: Record<string, unknown>[];
  /** Path to this page's markdown twin, if one exists (adds an alternate link). */
  mdTwin?: string;
}

const {
  title,
  description = 'Primate Intelligence — real-time video intelligence for the physical world.',
  canonicalPath,
  ogType = 'website',
  ogImage = '/Darwin_v3_vinyl_transparent.png',
  jsonLd = [],
  mdTwin,
} = Astro.props;

const site = Astro.site ?? new URL('https://primateintelligence.ai');
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site).href;
const ogImageAbs = new URL(ogImage, site).href;
const fullTitle = `${title} · Primate Intelligence`;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Primate Intelligence',
  legalName: 'Primate AI, Inc.',
  url: site.href,
  logo: new URL('/Darwin_v3_vinyl_transparent.png', site).href,
  description:
    'Real-time video intelligence API for the physical world, built on JEPA predictive world models.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1210 Redmond Ave',
    addressLocality: 'San Jose',
    addressRegion: 'CA',
    postalCode: '95120',
    addressCountry: 'US',
  },
  sameAs: ['https://www.linkedin.com/in/mattmiesnieks/'],
};

const ldBlocks = [organizationLd, ...jsonLd];

const pathname = Astro.url.pathname;
const inSection = (prefix: string) =>
  pathname === prefix || pathname.startsWith(prefix + '/');

const navGroups = [
  {
    label: 'Product',
    active: inSection('/use-cases') || inSection('/performance') || inSection('/agents'),
    items: [
      { label: 'Use cases', href: '/use-cases' },
      { label: 'Performance', href: '/performance' },
      { label: 'For AI agents', href: '/agents' },
      { label: 'Live demo', href: 'https://app.primateintelligence.ai/', external: true },
    ],
  },
  {
    label: 'Technology',
    active: inSection('/technology'),
    items: [
      { label: 'Overview', href: '/technology' },
      { label: 'How JEPA works', href: '/technology/how-jepa-works' },
      { label: 'Determinism', href: '/technology/determinism' },
      { label: 'Benchmarks', href: '/technology/benchmarks' },
      { label: 'Real-time streaming', href: '/technology/real-time' },
    ],
  },
];

const navFlat = [
  { label: 'Compare', href: '/compare', active: inSection('/compare') },
  { label: 'Docs', href: '/docs', active: inSection('/docs') },
  { label: 'Pricing', href: '/pricing', active: inSection('/pricing') },
];

const navResourcesGroup = {
  label: 'Resources',
  active: inSection('/blog') || inSection('/faq'),
  items: [
    { label: 'Blog', href: '/blog' },
    { label: 'FAQ', href: '/faq' },
    { label: 'RSS', href: '/rss.xml' },
    { label: 'llms.txt', href: '/llms.txt' },
  ],
};

const navAboutGroup = {
  label: 'About',
  active: inSection('/about') || inSection('/team') || inSection('/values') || inSection('/careers'),
  items: [
    { label: 'About us', href: '/about' },
    { label: 'Team', href: '/team' },
    { label: 'Values', href: '/values' },
    { label: 'Careers', href: '/careers' },
  ],
};

const allNavGroups = [...navGroups, navResourcesGroup, navAboutGroup];

// All mobile nav links flattened for the hamburger panel
const mobileLinks = [
  { label: 'Use cases', href: '/use-cases' },
  { label: 'Performance', href: '/performance' },
  { label: 'For AI agents', href: '/agents' },
  { label: 'Live demo', href: 'https://app.primateintelligence.ai/' },
  { label: 'Technology overview', href: '/technology' },
  { label: 'How JEPA works', href: '/technology/how-jepa-works' },
  { label: 'Determinism', href: '/technology/determinism' },
  { label: 'Benchmarks', href: '/technology/benchmarks' },
  { label: 'Real-time streaming', href: '/technology/real-time' },
  { label: 'Compare', href: '/compare' },
  { label: 'Docs', href: '/docs' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Blog', href: '/blog' },
  { label: 'FAQ', href: '/faq' },
  { label: 'About us', href: '/about' },
  { label: 'Team', href: '/team' },
  { label: 'Careers', href: '/careers' },
];

const footerColumns = [
  {
    title: 'Developers',
    links: [
      { label: 'Docs', href: '/docs' },
      { label: 'API reference', href: '/docs/reference' },
      { label: 'llms.txt', href: '/llms.txt' },
      { label: 'agents.md', href: '/agents.md' },
      { label: 'MCP Server on Smithery', href: 'https://smithery.ai/servers/matt-uwba/primate-intelligence' },
      { label: 'RSS', href: '/rss.xml' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Team', href: '/team' },
      { label: 'Careers', href: '/careers' },
      { label: 'Contact', href: 'mailto:matt@primateintelligence.ai' },
      { label: 'LinkedIn', href: 'https://www.linkedin.com/company/primate-intelligence/' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' },
      { label: 'Cookie Policy', href: '/cookie-policy' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/Darwin_v3_vinyl_transparent.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {mdTwin && <link rel="alternate" type="text/markdown" href={mdTwin} />}
    <link rel="alternate" type="application/rss+xml" title="Primate Intelligence Blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Primate Intelligence" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {ldBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- GA4 (G-NEMWN2PDNG) + AI-assistant referral attribution (PRI-492 item 8).
         Cookies disclosed in /cookie-policy. Mirrors the app's classifyAiReferral
         (src/primate/analytics/analytics.ts) so www + app report the same
         ai_referral event with the same ai_source values. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NEMWN2PDNG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NEMWN2PDNG');
      (function () {
        var AI_HOSTS = [
          [/(^|\.)chatgpt\.com$/, 'chatgpt'],
          [/^chat\.openai\.com$/, 'chatgpt'],
          [/(^|\.)perplexity\.ai$/, 'perplexity'],
          [/(^|\.)claude\.ai$/, 'claude'],
          [/^gemini\.google\.com$/, 'gemini'],
          [/^copilot\.microsoft\.com$/, 'copilot'],
        ];
        function match(value) {
          for (var i = 0; i < AI_HOSTS.length; i++) {
            if (AI_HOSTS[i][0].test(value)) return AI_HOSTS[i][1];
          }
          return null;
        }
        var source = null;
        try {
          var utm = new URLSearchParams(window.location.search).get('utm_source');
          if (utm) source = match(utm);
        } catch (e) { /* ignore */ }
        if (!source && document.referrer) {
          try { source = match(new URL(document.referrer).hostname); } catch (e) { /* ignore */ }
        }
        if (source) {
          gtag('event', 'ai_referral', { ai_source: source, page_path: window.location.pathname });
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <img src="/Darwin_v3_vinyl_transparent.png" alt="Primate Intelligence" width="36" height="36" />
          <span class="brand-text">
            <span class="brand-primate">Primate</span>
            <span class="brand-intelligence">Intelligence</span>
          </span>
        </a>

        <!-- Desktop nav -->
        <nav class="desktop-nav" aria-label="Main">
          {allNavGroups.map((group) => (
            <div class={`nav-group${group.active ? ' active' : ''}`}>
              <button class="nav-group-trigger" aria-haspopup="true" aria-expanded="false" type="button">
                {group.label} <span class="caret" aria-hidden="true">▾</span>
              </button>
              <div class="nav-dropdown" role="menu">
                {group.items.map((item) => (
                  <a
                    href={item.href}
                    role="menuitem"
                    class={pathname === item.href ? 'active' : ''}
                  >{item.label}</a>
                ))}
              </div>
            </div>
          ))}
          {navFlat.map((item) => (
            <a href={item.href} class={item.active ? 'active' : ''}>{item.label}</a>
          ))}
          <a class="nav-cta" href="https://app.primateintelligence.ai/">Try Primate Vision</a>
        </nav>

        <!-- Hover-intent for desktop dropdowns: grace period on mouseleave so
             diagonal cursor paths toward a submenu don't snap the menu shut;
             click/tap toggles for trackpads and touch; Escape + outside-click close. -->
        <script>
          const CLOSE_GRACE_MS = 300;
          document.querySelectorAll('.desktop-nav .nav-group').forEach((group) => {
            const trigger = group.querySelector('.nav-group-trigger');
            let closeTimer;
            const setOpen = (open) => {
              group.classList.toggle('open', open);
              if (trigger) trigger.setAttribute('aria-expanded', String(open));
            };
            group.addEventListener('mouseenter', () => {
              clearTimeout(closeTimer);
              setOpen(true);
            });
            group.addEventListener('mouseleave', () => {
              clearTimeout(closeTimer);
              closeTimer = setTimeout(() => setOpen(false), CLOSE_GRACE_MS);
            });
            if (trigger) trigger.addEventListener('click', (e) => {
              e.stopPropagation();
              const willOpen = !group.classList.contains('open');
              document.querySelectorAll('.desktop-nav .nav-group.open').forEach((g) => {
                if (g !== group) {
                  g.classList.remove('open');
                  g.querySelector('.nav-group-trigger')?.setAttribute('aria-expanded', 'false');
                }
              });
              setOpen(willOpen);
            });
          });
          const closeAll = () => document.querySelectorAll('.desktop-nav .nav-group.open').forEach((g) => {
            g.classList.remove('open');
            g.querySelector('.nav-group-trigger')?.setAttribute('aria-expanded', 'false');
          });
          document.addEventListener('click', (e) => {
            if (!(e.target instanceof Element) || !e.target.closest('.nav-group')) closeAll();
          });
          document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
        </script>

        <!-- Mobile hamburger (hidden on desktop) -->
        <details class="mobile-menu">
          <summary class="hamburger" aria-label="Open navigation menu">
            <span class="ham-icon" aria-hidden="true">☰</span>
            <span class="ham-close" aria-hidden="true">✕</span>
          </summary>
          <div class="mobile-panel">
            {mobileLinks.map((link) => (
              <a href={link.href} class={pathname === link.href ? 'active' : ''}>{link.label}</a>
            ))}
            <a class="mobile-cta" href="https://app.primateintelligence.ai/">Try Primate Vision →</a>
          </div>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-brand-col">
            <a href="/" class="footer-brand">
              <img src="/Darwin_v3_vinyl_transparent.png" alt="" width="28" height="28" />
              <span class="brand-text">
                <span class="brand-primate">Primate</span>
                <span class="brand-intelligence">Intelligence</span>
              </span>
            </a>
            <p class="footer-tagline">Real-time video intelligence API, built on predictive world models.</p>
          </div>
          {footerColumns.map((col) => (
            <div class="footer-col">
              <div class="footer-col-title">{col.title}</div>
              <ul>
                {col.links.map((link) => (
                  <li><a href={link.href}>{link.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Primate AI, Inc. · San Jose, CA</p>
          <p class="footer-mono">api.primateintelligence.ai</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ── Header ────────────────────────────────────────────── */
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-surface);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .header-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 14px 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-primary);
    flex-shrink: 0;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.12;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .brand-primate { color: var(--color-text-primary); }
  .brand-intelligence { color: #2058f0; }

  /* ── Desktop nav ───────────────────────────────────────── */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    font-weight: 500;
  }
  .desktop-nav > a {
    color: var(--color-text-primary);
    padding: 6px 10px;
    border-radius: 4px;
  }
  .desktop-nav > a:hover,
  .desktop-nav > a.active { color: var(--color-signal); }

  /* dropdown groups */
  .nav-group {
    position: relative;
  }
  .nav-group-trigger {
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-primary);
    padding: 6px 10px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 3px;
  }
  .nav-group-trigger:hover,
  .nav-group.active .nav-group-trigger { color: var(--color-signal); }
  .caret { font-size: 9px; }

  .nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    padding: 6px;
    min-width: 180px;
    z-index: 100;
    white-space: nowrap;
  }
  /* Invisible hover bridge across the 6px visual gap between trigger and
     dropdown — without it, crossing the gap fires mouseleave and the menu
     snaps shut mid-movement (reported by Matt 2026-08-01). */
  .nav-dropdown::before {
    content: '';
    position: absolute;
    top: -10px;
    left: -8px;
    right: -8px;
    height: 10px;
  }
  .nav-group:hover .nav-dropdown,
  .nav-group.open .nav-dropdown,
  .nav-group:focus-within .nav-dropdown { display: flex; flex-direction: column; }
  .nav-dropdown a {
    color: var(--color-text-primary);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 4px;
    display: block;
  }
  .nav-dropdown a:hover,
  .nav-dropdown a.active {
    background: var(--color-signal-subtle);
    color: var(--color-signal);
  }

  .nav-cta {
    background: var(--color-signal);
    color: #fff !important;
    padding: 8px 16px;
    border-radius: var(--radius-lg);
    font-weight: 600;
    margin-left: 8px;
  }
  .nav-cta:hover { background: var(--color-signal-hover); }

  /* ── Mobile hamburger ──────────────────────────────────── */
  .mobile-menu { display: none; }
  .hamburger {
    list-style: none;
    cursor: pointer;
    padding: 6px 10px;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    font-size: 18px;
    color: var(--color-text-primary);
    user-select: none;
  }
  .hamburger::-webkit-details-marker { display: none; }
  .ham-close { display: none; }
  details[open] .ham-icon { display: none; }
  details[open] .ham-close { display: inline; }

  .mobile-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-bg-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 16px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 50;
  }
  .mobile-panel a {
    color: var(--color-text-primary);
    font-size: 15px;
    font-weight: 500;
    padding: 10px 8px;
    border-radius: 4px;
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-panel a:last-child { border-bottom: none; }
  .mobile-panel a:hover, .mobile-panel a.active { color: var(--color-signal); }
  .mobile-cta {
    margin-top: 12px;
    background: var(--color-signal);
    color: #fff !important;
    padding: 12px 16px !important;
    border-radius: 6px;
    font-weight: 600;
    text-align: center;
    border: none !important;
  }

  main {
    flex: 1;
    width: 100%;
  }

  /* ── Footer ────────────────────────────────────────────── */
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .footer-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 48px 24px 32px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr repeat(3, auto);
    gap: 48px;
    margin-bottom: 40px;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-primary);
    margin-bottom: 12px;
  }
  .footer-tagline { max-width: 260px; line-height: 1.6; margin: 0; }
  .footer-col-title {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    font-weight: 600;
    margin-bottom: 14px;
  }
  .footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .footer-col a { color: var(--color-text-muted); }
  .footer-col a:hover { color: var(--color-text-primary); }
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  .footer-bottom p { margin: 0; font-size: 12px; }
  .footer-mono { font-family: var(--font-mono); font-size: 11px; }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .mobile-menu { display: block; position: relative; }
  }
  @media (min-width: 901px) {
    .mobile-menu { display: none !important; }
  }
  @media (max-width: 820px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
