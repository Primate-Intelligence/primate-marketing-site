---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  dateLine?: string;
}

const { title, description, canonicalPath, dateLine } = Astro.props;
---

<Base title={title} description={description} canonicalPath={canonicalPath}>
  <div class="legal-page">
    <p class="label">LEGAL</p>
    <h1>{title}</h1>
    {dateLine && <p class="dateline">{dateLine}</p>}
    <div class="legal-body">
      <slot />
    </div>
  </div>
</Base>

<style is:global>
  .legal-page {
    max-width: 700px;
    margin: 0 auto;
    padding: 144px 24px 192px;
  }
  .legal-page .label {
    font-family: var(--font-mono);
    font-size: var(--fs-caption-1);
    color: var(--color-signal);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 16px;
  }
  .legal-page h1 {
    font-weight: 800;
    font-size: var(--fs-h1);
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    line-height: 1.1;
  }
  .legal-page .dateline {
    font-family: var(--font-mono);
    font-size: var(--fs-footnote);
    color: var(--color-text-muted);
    margin: 0 0 64px;
  }
  .legal-body h2 {
    font-weight: 700;
    font-size: var(--fs-h4);
    letter-spacing: -0.02em;
    margin: 80px 0 24px;
    line-height: 1.3;
  }
  .legal-body h3 {
    font-weight: 600;
    font-size: var(--fs-body);
    margin: 48px 0 16px;
    line-height: 1.4;
  }
  .legal-body p {
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    line-height: 1.7;
    margin: 0 0 12px;
  }
  .legal-body ul {
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    line-height: 1.7;
    margin: 0 0 12px;
    padding-left: 22px;
  }
  .legal-body li { margin-bottom: 8px; }
  .legal-body strong { color: var(--color-text-primary); }
  .legal-body code {
    font-family: var(--font-mono);
    font-size: var(--fs-subhead);
  }
</style>
