---
/**
 * Docs shell (PRI-504) — sidebar nav + content + on-page TOC, static HTML.
 * Mirrors the SPA's DocsLayout information architecture (sections from the
 * corpus, not hand-maintained).
 */
import Base from './Base.astro';
import { getDocsNav } from '../lib/docsCorpus';

interface Props {
  title: string;
  description: string;
  /** Active docs slug, e.g. "quickstart" or "guides/uploading". */
  activeSlug: string;
  canonicalPath: string;
  /** Path to this page's markdown twin. */
  mdTwin?: string;
  headings?: Array<{ depth: number; text: string; id: string }>;
}

const { title, description, activeSlug, canonicalPath, mdTwin, headings = [] } = Astro.props;
const nav = await getDocsNav();
---

<Base title={title} description={description} canonicalPath={canonicalPath} mdTwin={mdTwin}>
  <div class="docs-shell">
    <aside class="docs-sidebar" aria-label="Docs navigation">
      {nav.map((group) => (
        <div class="nav-group">
          <div class="nav-section">{group.section}</div>
          <ul>
            {group.pages.map((p) => (
              <li>
                <a
                  href={p.slug === 'quickstart' ? '/docs' : `/docs/${p.slug}`}
                  class:list={{ active: p.slug === activeSlug }}
                  title={p.description}
                >
                  {p.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="nav-group">
        <div class="nav-section">Machine-readable</div>
        <ul>
          <li><a href="https://api.primateintelligence.ai/v1/openapi.json">OpenAPI 3.1 spec</a></li>
          {mdTwin && <li><a href={mdTwin}>This page as markdown</a></li>}
          <li><a href="/llms.txt">llms.txt</a></li>
        </ul>
      </div>
    </aside>

    <article class="docs-content">
      <slot />
      {mdTwin && (
        <footer class="md-note">
          Prefer raw text? This page is available as <a href={mdTwin}>markdown</a>.
        </footer>
      )}
    </article>

    {headings.length > 1 && (
      <nav class="docs-toc" aria-label="On this page">
        <div class="toc-title">On this page</div>
        <ul>
          {headings.map((h) => (
            <li class:list={[`depth-${h.depth}`]}>
              <a href={`#${h.id}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</Base>

<style is:global>
  .docs-shell {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 220px;
    gap: 48px;
    padding: 40px 24px 96px;
    align-items: start;
  }
  .docs-sidebar {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 112px);
    overflow-y: auto;
    font-size: 14px;
  }
  .docs-sidebar .nav-group { margin-bottom: 24px; }
  .docs-sidebar .nav-section {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 600;
    margin-bottom: 8px;
  }
  .docs-sidebar ul { list-style: none; padding: 0; margin: 0; }
  .docs-sidebar li a {
    display: block;
    padding: 5px 10px;
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .docs-sidebar li a:hover { color: var(--color-text-primary); background: var(--color-bg-secondary); }
  .docs-sidebar li a.active {
    color: var(--color-signal);
    background: var(--color-signal-subtle);
    font-weight: 600;
  }

  .docs-toc {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 112px);
    overflow-y: auto;
    font-size: 13px;
  }
  .docs-toc .toc-title {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 600;
    margin-bottom: 8px;
  }
  .docs-toc ul { list-style: none; padding: 0; margin: 0; }
  .docs-toc li { margin: 6px 0; line-height: 1.4; }
  .docs-toc li.depth-3 { padding-left: 14px; }
  .docs-toc a { color: var(--color-text-muted); }
  .docs-toc a:hover { color: var(--color-signal); }

  .docs-content { min-width: 0; }
  .docs-content h1 { font-size: 36px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin: 0 0 20px; }
  .docs-content h2 { font-size: 24px; font-weight: 700; letter-spacing: -0.01em; margin: 40px 0 14px; scroll-margin-top: 90px; }
  .docs-content h3 { font-size: 18px; font-weight: 600; margin: 28px 0 10px; scroll-margin-top: 90px; }
  .docs-content h4 { font-size: 15px; font-weight: 600; margin: 20px 0 8px; }
  .docs-content p, .docs-content li { font-size: 15px; line-height: 1.7; color: var(--color-text-primary); }
  .docs-content p { margin: 0 0 14px; }
  .docs-content ul, .docs-content ol { padding-left: 24px; margin: 0 0 14px; }
  .docs-content li { margin: 4px 0; }
  .docs-content a { color: var(--color-signal); }
  .docs-content a:hover { text-decoration: underline; }
  .docs-content code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--color-bg-code);
    padding: 2px 5px;
    border-radius: var(--radius-sm);
  }
  .docs-content pre {
    background: var(--color-bg-code);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 16px;
    overflow-x: auto;
    margin: 0 0 18px;
  }
  .docs-content pre code { background: none; padding: 0; font-size: 13px; line-height: 1.6; }
  .docs-content table {
    border-collapse: collapse;
    width: 100%;
    margin: 0 0 18px;
    font-size: 14px;
  }
  .docs-content th, .docs-content td {
    border: 1px solid var(--color-border);
    padding: 8px 12px;
    text-align: left;
    vertical-align: top;
  }
  .docs-content th { background: var(--color-bg-secondary); font-weight: 600; }
  .docs-content blockquote {
    border-left: 3px solid var(--color-signal);
    margin: 0 0 14px;
    padding: 4px 0 4px 16px;
    color: var(--color-text-muted);
  }
  .docs-content hr { border: none; border-top: 1px solid var(--color-border); margin: 32px 0; }
  .docs-content .md-note {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    font-size: 13px;
    color: var(--color-text-muted);
  }

  @media (max-width: 1080px) {
    .docs-shell { grid-template-columns: 220px minmax(0, 1fr); }
    .docs-toc { display: none; }
  }
  @media (max-width: 760px) {
    .docs-shell { grid-template-columns: 1fr; gap: 24px; }
    .docs-sidebar { position: static; max-height: none; }
  }
</style>
