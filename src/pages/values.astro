---
import Base from '../layouts/Base.astro';
import { VALUES, VALUES_HERO, VALUES_TEAM } from '../data/values';
---

<Base
  title="Our Values"
  description="Built on substance, not status. Seven principles that guide how Primate Intelligence works, who we hire, and what we build."
  canonicalPath="/values"
>
  <div class="page">
    <section class="hero">
      <p class="eyebrow">{VALUES_HERO.eyebrow}</p>
      <h1>{VALUES_HERO.heading}</h1>
      <p class="lede">{VALUES_HERO.lede}</p>
      <p class="attribution">
        <span class="avatar">MM</span>
        {VALUES_HERO.attribution}
      </p>
    </section>

    <section class="values">
      {VALUES.map((value) => (
        <article class="value-card">
          <p class="value-name">{value.name}</p>
          <p class="value-body">{value.body}</p>
        </article>
      ))}
    </section>

    <section class="team">
      <div class="team-header">
        <p class="eyebrow">{VALUES_TEAM.eyebrow}</p>
        <h2>{VALUES_TEAM.heading}</h2>
      </div>
      <div class="team-grid">
        {VALUES_TEAM.members.map((m) => (
          <div class="member">
            <img src={m.image} alt={m.name} width="96" height="96" />
            <h3>{m.name}</h3>
            <p class="member-title">{m.title}</p>
            <p class="member-blurb">{m.blurb}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .page { max-width: 860px; margin: 0 auto; padding: 64px 24px 96px; }
  .hero { text-align: center; margin-bottom: 56px; }
  .eyebrow {
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 14px;
  }
  h1 { font-size: 44px; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 14px; }
  .lede { font-size: 17px; color: var(--color-text-muted); max-width: 520px; margin: 0 auto; line-height: 1.6; }
  .attribution {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
    font-size: 14px;
    color: var(--color-text-muted);
  }
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-signal);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .value-card {
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-signal);
    border-radius: 0 12px 12px 0;
    background: var(--color-bg-surface);
    padding: 28px 32px;
    margin-bottom: 16px;
  }
  .value-name {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-signal);
    margin: 0 0 10px;
  }
  .value-body { font-size: 16px; line-height: 1.7; margin: 0; }

  .team { margin-top: 80px; }
  .team-header { text-align: center; margin-bottom: 40px; }
  h2 { font-size: 32px; font-weight: 600; letter-spacing: -0.015em; margin: 0; }
  .team-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    max-width: 640px;
    margin: 0 auto;
  }
  .member { text-align: center; }
  .member img {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
    margin-bottom: 18px;
  }
  h3 { font-size: 19px; font-weight: 600; margin: 0 0 4px; }
  .member-title {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-signal);
    margin: 0 0 12px;
    font-weight: 500;
  }
  .member-blurb { font-size: 14px; color: var(--color-text-muted); line-height: 1.65; margin: 0; }

  @media (max-width: 640px) {
    .team-grid { grid-template-columns: 1fr; }
    h1 { font-size: 32px; }
    .page { padding: 44px 20px 64px; }
  }
</style>
