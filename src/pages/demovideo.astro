---
import Base from '../layouts/Base.astro';

const VIDEO_URL =
  'https://dpqqdfo8p9efcp8w.public.blob.vercel-storage.com/demo/darwin-learn-and-recall-on-device-cropped-CHlsRNPr9QSu4eRFtn2LmJZu64RkKQ.mov';
---

<Base
  title="Demo Video"
  description="Darwin learn & recall, on-device."
  canonicalPath="/demovideo"
>
  <div class="demovideo-page">
    <video controls playsinline src={VIDEO_URL}>
      Your browser does not support the video tag.
    </video>
  </div>
</Base>

<style>
  .demovideo-page {
    min-height: calc(100vh - var(--header-height, 0px));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    box-sizing: border-box;
  }

  .demovideo-page video {
    max-width: 100%;
    max-height: 85vh;
    width: auto;
    height: auto;
  }
</style>
