---
import '../styles/tokens.css';

const VIDEOS = [
  {
    id: 'mop',
    title: 'Darwin learns to mop',
    url: 'https://dpqqdfo8p9efcp8w.public.blob.vercel-storage.com/demo/darwin-learns-to-mop.mp4',
    poster: '/images/demovideo/mop-poster.jpg',
  },
  {
    id: 'pack-the-shelf',
    title: 'Darwin learns to pack the shelf',
    url: 'https://dpqqdfo8p9efcp8w.public.blob.vercel-storage.com/demo/darwin-learns-to-pack-the-shelf.mp4',
    poster: '/images/demovideo/pack-poster.jpg',
  },
  {
    id: 'pickup',
    title: 'Darwin learns to pickup',
    url: 'https://dpqqdfo8p9efcp8w.public.blob.vercel-storage.com/demo/darwin-learns-to-pickup.mp4',
    poster: '/images/demovideo/pickup-poster.jpg',
  },
];

const title = 'Darwin learns on the job — Primate Intelligence demo';
const description =
  'Three clips, one take each, entirely at 1x speed: Darwin learns to mop, pack a shelf, and pick things up. No teleoperation, no pre- or post-training, weights updating live.';
const site = Astro.site ?? new URL('https://primateintelligence.ai');
const canonical = new URL('/demovideo/', site).href;
const ogImage = new URL('/images/demovideo/og.jpg', site).href;
const isDevEnv = import.meta.env.PUBLIC_SITE_ENV === 'dev';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/Darwin_v3_vinyl_transparent.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isDevEnv && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Primate Intelligence" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <a class="brand" href="/">
      <img src="/Darwin_v3_vinyl_transparent.png" alt="Primate Intelligence" width="36" height="36" />
      <span class="brand-text">
        <span class="brand-primate">Primate</span>
        <span class="brand-intelligence">Intelligence</span>
      </span>
    </a>

    <main class="page">
      <!-- §1.1 Hero -->
      <section class="hero">
        <p class="eyebrow">PRIMATE INTELLIGENCE · DARWIN · DEMO</p>
        <h1>Darwin learns on the job. Watch it, three times.</h1>
        <p class="sub">
          Three clips, one take each: a person shows Darwin a new action once — mop, pack a
          shelf, pick things up — and it does it.
        </p>

        <ul class="chips">
          <li class="chip">
            <span class="chip-term">entirely 1X speed</span>
          </li>
          <li class="chip">
            <span class="chip-term">weights are being updated</span>
            <span class="chip-note">as it learns in real-time</span>
          </li>
          <li class="chip">
            <span class="chip-term">no teleoperation</span>
          </li>
          <li class="chip">
            <span class="chip-term">no pre or post-training</span>
          </li>
          <li class="chip">
            <span class="chip-term">take 1 of 1</span>
          </li>
        </ul>
      </section>

      <!-- §1.2 The three clips -->
      {VIDEOS.map((v) => (
        <section class="clip" id={v.id}>
          <h2>{v.title}</h2>
          <div class="video-wrap">
            <video controls playsinline preload="metadata" poster={v.poster} src={v.url}>
              Your browser does not support the video tag.
            </video>
          </div>
        </section>
      ))}

      <!-- §1.3 Why this is hard -->
      <section class="why-hard">
        <h2>Darwin powers the fastest learning robots</h2>
        <p class="lede">You just saw, in real-time, with no speedups:</p>
        <ol class="steps">
          <li>Darwin is asked to do something it doesn't know how to do.</li>
          <li>
            It asks to be shown how, then watches a non-technical person with no equipment, one
            time.
          </li>
          <li>It learns the new action locally on-device, and updates its weights.</li>
          <li>It's ready to share that learning with all other Darwin robots.</li>
        </ol>
        <blockquote class="pull-quote">
          The test for any robot model: does it learn a new task after it ships, with no training
          cycle, and keep it?
        </blockquote>
      </section>

      <!-- §1.6 Footer -->
      <footer class="page-footer">
        <p>
          Primate Intelligence builds Darwin, the robot foundation model that learns on the job.
          Raising a priced seed. →
          <a href="mailto:matt@primateintelligence.ai">matt@primateintelligence.ai</a>
        </p>
        <p><a href="/one-pager.pdf">One-pager (PDF)</a></p>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(html, body) {
    margin: 0;
    padding: 0;
    background: var(--color-bg-primary, #f2f0eb);
    color: var(--color-text-primary, #1a1916);
    font-family: var(--font-sans);
  }

  /* Brand mark, fixed top-left (no header/nav on this page by design) */
  .brand {
    position: fixed;
    top: 20px;
    left: 24px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-primary, #1a1916);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.12;
    font-size: var(--fs-body-sm, 14px);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .brand-primate { color: var(--color-text-primary, #1a1916); }
  .brand-intelligence { color: var(--color-signal, #1b4fe0); }

  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 108px 24px 48px;
  }

  section { margin: 0 0 72px; }

  h2 {
    font-weight: 700;
    font-size: var(--fs-h3, 28px);
    letter-spacing: -0.01em;
    margin: 0 0 20px;
  }

  /* §1.1 Hero */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-subhead, 13px);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-signal, #1b4fe0);
    margin: 0 0 16px;
  }
  h1 {
    font-weight: 800;
    font-size: clamp(34px, 6vw, var(--fs-h1, 48px));
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin: 0 0 20px;
  }
  .sub {
    font-size: var(--fs-body-lg, 18px);
    font-weight: 400;
    line-height: 1.55;
    max-width: 44em;
    margin: 0 0 32px;
    font-style: italic;
  }

  .chips {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
  }
  .chip {
    background: var(--color-bg-surface, #fafaf7);
    border: 1px solid var(--color-border, #d4d0c8);
    border-radius: 0;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .chip-term {
    font-family: var(--font-mono);
    font-size: var(--fs-body-sm, 14px);
    font-weight: 500;
    color: var(--color-text-primary, #1a1916);
  }
  .chip-note {
    font-size: var(--fs-subhead, 13px);
    color: var(--color-text-muted, #7a7669);
    line-height: 1.4;
  }

  /* §1.2 Clips */
  .clip h2 {
    font-size: var(--fs-h4, 22px);
  }
  .video-wrap {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    background: var(--color-text-primary, #1a1916);
    border: 1px solid var(--color-border, #d4d0c8);
    border-radius: 0;
  }
  .video-wrap video {
    display: block;
    width: 100%;
    max-height: 85vh;
    margin: 0 auto;
  }

  /* §1.3 Why this is hard */
  .why-hard .lede {
    font-size: var(--fs-body-lg, 18px);
    line-height: 1.6;
    max-width: 44em;
    margin: 0 0 20px;
  }
  .steps {
    margin: 0 0 28px;
    padding-left: 1.3em;
    max-width: 44em;
  }
  .steps li {
    font-size: var(--fs-body, 16px);
    line-height: 1.6;
    margin: 0 0 14px;
  }
  .pull-quote {
    margin: 0;
    padding: 24px 28px;
    background: var(--color-bg-secondary, #e8e5de);
    border: 1px solid var(--color-border, #d4d0c8);
    border-left: 3px solid var(--color-signal, #1b4fe0);
    border-radius: 0;
    color: var(--color-signal, #1b4fe0);
    font-weight: 700;
    font-size: var(--fs-title-1, 20px);
    line-height: 1.45;
  }

  /* §1.6 Footer */
  .page-footer {
    border-top: 1px solid var(--color-border, #d4d0c8);
    padding-top: 28px;
    color: var(--color-text-muted, #7a7669);
    font-size: var(--fs-body-sm, 14px);
    line-height: 1.6;
  }
  .page-footer p { margin: 0 0 10px; max-width: 44em; }
  .page-footer a { color: var(--color-signal, #1b4fe0); }

  @media (max-width: 720px) {
    .page { padding: 96px 16px 40px; }
    section { margin-bottom: 56px; }
    .chips { grid-template-columns: 1fr 1fr; }
  }
</style>
