---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, formatDate } from '../../lib/blog';

const posts = await getPublishedPosts();

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Primate Intelligence Blog',
  description: 'Research notes and perspectives from the Primate Intelligence team.',
  url: 'https://primateintelligence.ai/blog',
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `https://primateintelligence.ai/blog/${p.data.slug}`,
    datePublished: p.data.date,
    author: { '@type': 'Person', name: p.data.author },
  })),
};
---

<Base
  title="Blog"
  description="Thinking out loud — research notes and perspectives from the Primate Intelligence team."
  canonicalPath="/blog"
  jsonLd={[blogLd]}
>
  <div class="page">
    <section class="hero">
      <p class="eyebrow">From the Lab</p>
      <h1>Thinking Out Loud</h1>
      <p class="lede">Research notes and perspectives from the Primate Intelligence team.</p>
    </section>

    <section class="posts">
      {posts.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <div class="grid">
          {posts.map((post) => (
            <a class="card" href={`/blog/${post.data.slug}`}>
              {post.data.tags[0] && <span class="tag">{post.data.tags[0]}</span>}
              <h2>{post.data.title}</h2>
              <p class="excerpt">{post.data.excerpt}</p>
              <div class="meta">
                <span class="avatar">{post.data.authorInitials}</span>
                <span>{post.data.author}</span>
                <span>·</span>
                <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
                <span>·</span>
                <span>{post.data.readTime}</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <p class="rss-note">
      Subscribe via <a href="/rss.xml">RSS</a>. Every post is also available as raw markdown —
      append <code>.md</code> to any post URL.
    </p>
  </div>
</Base>

<style>
  .page { max-width: 1120px; margin: 0 auto; padding: 64px 24px 96px; }
  .hero { text-align: center; margin-bottom: 56px; }
  .eyebrow {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 14px;
  }
  h1 { font-size: 44px; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 14px; }
  .lede { font-size: 16px; color: var(--color-text-muted); max-width: 480px; margin: 0 auto; }
  .empty { text-align: center; color: var(--color-text-muted); padding: 64px 0; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    color: inherit;
  }
  .card:hover { border-color: rgba(27, 79, 224, 0.4); color: inherit; }
  .tag {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-signal-subtle);
    color: var(--color-signal);
  }
  h2 { font-size: 19px; font-weight: 600; line-height: 1.4; margin: 16px 0 0; }
  .excerpt {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 12px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--color-text-muted);
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-signal);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .rss-note { margin-top: 48px; text-align: center; font-size: 13px; color: var(--color-text-muted); }

  @media (max-width: 980px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
    h1 { font-size: 32px; }
    .page { padding: 44px 20px 64px; }
  }
</style>
