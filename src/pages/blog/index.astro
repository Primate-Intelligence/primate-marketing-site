---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, formatDate } from '../../lib/blog';

const posts = await getPublishedPosts();

// Map first matching tag to a display category
function getCategory(tags: string[]): string {
  for (const tag of tags) {
    if (tag === 'Announcement') return 'Announcements';
    if (tag === 'Perspective' || tag === 'Founding' || tag === 'Market Analysis') return 'Perspective';
    if (tag === 'Engineering' || tag === 'Infrastructure') return 'Engineering';
    if (tag === 'Research' || tag === 'JEPA' || tag === 'Benchmarks') return 'Research';
  }
  return 'Perspective'; // fallback
}

const categories = ['All', 'Announcements', 'Perspective', 'Engineering', 'Research'];

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Primate Intelligence Blog',
  description: 'Research notes and perspectives from the Primate Intelligence team.',
  url: 'https://primateintelligence.ai/blog',
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `https://primateintelligence.ai/blog/${p.data.slug}`,
    datePublished: p.data.date,
    author: { '@type': 'Person', name: p.data.author },
  })),
};
---

<Base
  title="Blog"
  description="Thinking out loud — research notes and perspectives from the Primate Intelligence team."
  canonicalPath="/blog"
  jsonLd={[blogLd]}
>
  <div class="page">
    <section class="hero">
      <p class="eyebrow">From the Lab</p>
      <h1>Thinking Out Loud</h1>
      <p class="lede">Research notes and perspectives from the Primate Intelligence team.</p>
    </section>

    <div class="filters" role="group" aria-label="Filter by category">
      {categories.map((cat) => (
        <button
          class={`filter-pill${cat === 'All' ? ' active' : ''}`}
          data-filter={cat}
          type="button"
        >{cat}</button>
      ))}
    </div>

    <section class="posts">
      {posts.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <div class="grid">
          {posts.map((post) => {
            const cat = getCategory(post.data.tags);
            return (
              <a class="card" href={`/blog/${post.data.slug}`} data-category={cat}>
                {post.data.tags[0] && <span class="tag">{post.data.tags[0]}</span>}
                <h2>{post.data.title}</h2>
                <p class="excerpt">{post.data.excerpt}</p>
                <div class="meta">
                  <span class="avatar">{post.data.authorInitials}</span>
                  <span>{post.data.author}</span>
                  <span>·</span>
                  <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
                  <span>·</span>
                  <span>{post.data.readTime}</span>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>

    <p class="rss-note">
      Subscribe via <a href="/rss.xml">RSS</a>. Every post is also available as raw markdown —
      append <code>.md</code> to any post URL.
    </p>
  </div>
</Base>

<script is:inline>
  (function () {
    var pills = document.querySelectorAll('.filter-pill');
    var cards = document.querySelectorAll('.card[data-category]');
    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        var filter = pill.getAttribute('data-filter');
        pills.forEach(function (p) { p.classList.remove('active'); });
        pill.classList.add('active');
        cards.forEach(function (card) {
          if (filter === 'All' || card.getAttribute('data-category') === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  })();
</script>

<style>
  .page { max-width: 1120px; margin: 0 auto; padding: 128px 24px 192px; }
  .hero { text-align: center; margin-bottom: 80px; }
  .eyebrow {
    font-size: var(--fs-subhead);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 14px;
  }
  h1 { font-size: var(--fs-h1); font-weight: 700; letter-spacing: -0.02em; margin: 0 0 14px; }
  .lede { font-size: var(--fs-body); color: var(--color-text-muted); max-width: 480px; margin: 0 auto; }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 64px;
  }
  .filter-pill {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 6px 16px;
    font-size: var(--fs-subhead);
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 150ms;
  }
  .filter-pill:hover { border-color: var(--color-signal); color: var(--color-signal); }
  .filter-pill.active {
    background: var(--color-signal);
    border-color: var(--color-signal);
    color: #fff;
  }

  .empty { text-align: center; color: var(--color-text-muted); padding: 128px 0; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 24px; }
  .card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 48px 24px;
    display: flex;
    flex-direction: column;
    color: inherit;
  }
  .card:hover { border-color: rgba(27, 79, 224, 0.4); color: inherit; }
  .tag {
    align-self: flex-start;
    font-size: var(--fs-caption-1);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-signal-subtle);
    color: var(--color-signal);
  }
  h2 { font-size: var(--fs-title-2); font-weight: 600; line-height: 1.4; margin: 16px 0 0; }
  .excerpt {
    font-size: var(--fs-body-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 12px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-footnote);
    color: var(--color-text-muted);
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-signal);
    color: #fff;
    font-size: var(--fs-caption-2);
    font-weight: 700;
    flex-shrink: 0;
  }
  .rss-note { margin-top: 96px; text-align: center; font-size: var(--fs-subhead); color: var(--color-text-muted); }

  @media (max-width: 980px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
    h1 { font-size: var(--fs-h2); }
    .page { padding: 88px 20px 128px; }
  }
</style>
