---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, formatDate, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  // CRITICAL (PRI-502 / Matt's review): the route param comes from the
  // frontmatter `slug`, NOT the filename — legacy /blog/:slug URLs are
  // preserved 1:1 with zero Astro filename normalization.
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const postingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.excerpt,
  datePublished: d.date,
  author: { '@type': 'Person', name: d.author },
  publisher: {
    '@type': 'Organization',
    name: 'Primate Intelligence',
    logo: {
      '@type': 'ImageObject',
      url: 'https://primateintelligence.ai/Darwin_v3_vinyl_transparent.png',
    },
  },
  mainEntityOfPage: `https://primateintelligence.ai/blog/${d.slug}`,
};
---

<Base
  title={d.title}
  description={d.excerpt}
  canonicalPath={`/blog/${d.slug}`}
  ogType="article"
  jsonLd={[postingLd]}
  mdTwin={`/blog/${d.slug}.md`}
>
  <article class="post">
    <header>
      <a class="back" href="/blog">← All posts</a>
      <div class="tags">
        {d.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <h1>{d.title}</h1>
      <div class="meta">
        <span class="avatar">{d.authorInitials}</span>
        <span>{d.author}</span>
        <span>·</span>
        <time datetime={d.date}>{formatDate(d.date, 'long')}</time>
        <span>·</span>
        <span>{d.readTime}</span>
      </div>
      <hr />
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer>
      <p class="md-note">
        Prefer raw text? This post is available as
        <a href={`/blog/${d.slug}.md`}>markdown</a>.
      </p>
    </footer>
  </article>
</Base>

<style>
  .post { max-width: 700px; margin: 0 auto; padding: 128px 24px 192px; }
  .back { font-size: var(--fs-body-sm); color: var(--color-text-muted); }
  .back:hover { color: var(--color-signal); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .tag {
    font-size: var(--fs-caption-1);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-signal-subtle);
    color: var(--color-signal);
  }
  h1 { font-size: var(--fs-display-s); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin: 48px 0 0; }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 48px;
    font-size: var(--fs-body-sm);
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-signal);
    color: #fff;
    font-size: var(--fs-footnote);
    font-weight: 700;
    flex-shrink: 0;
  }
  hr { border: none; border-top: 1px solid var(--color-border); margin: 64px 0 80px; }

  .prose { font-size: var(--fs-body-lg); line-height: 1.75; }
  .prose :global(h2) { font-size: var(--fs-h3); font-weight: 600; letter-spacing: -0.015em; margin: 80px 0 32px; }
  .prose :global(h3) { font-size: var(--fs-title-1); font-weight: 600; margin: 64px 0 24px; }
  .prose :global(p) { margin: 0 0 16px; color: var(--color-text-primary); opacity: 0.85; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 16px; padding-left: 24px; color: var(--color-text-primary); opacity: 0.85; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(blockquote) {
    border-left: 2px solid rgba(27, 79, 224, 0.5);
    padding-left: 20px;
    margin: 48px 0;
    font-style: italic;
    color: var(--color-text-muted);
  }
  .prose :global(pre) {
    background: #1a1916;
    color: #e6e9f4;
    border-radius: 8px;
    padding: 18px 20px;
    overflow-x: auto;
    font-size: var(--fs-subhead);
    line-height: 1.6;
  }
  .prose :global(pre code) { background: none; padding: 0; color: inherit; }
  .prose :global(img) { max-width: 100%; border-radius: 8px; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--color-border); margin: 80px 0; }
  .prose :global(table) { border-collapse: collapse; width: 100%; margin: 0 0 16px; font-size: var(--fs-body); }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--color-border); padding: 8px 12px; text-align: left; }

  footer { margin-top: 112px; border-top: 1px solid var(--color-border); padding-top: 40px; }
  .md-note { font-size: var(--fs-subhead); color: var(--color-text-muted); }

  @media (max-width: 640px) {
    h1 { font-size: var(--fs-h3); }
    .post { padding: 80px 20px 128px; }
  }
</style>
