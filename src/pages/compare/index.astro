---
import Base from '../../layouts/Base.astro';
import { getCompareEntries } from '../../lib/compare';
import { formatDate } from '../../lib/blog';

const allEntries = await getCompareEntries();

// Featured at top: roundup + landscape overview
const FEATURED_SLUGS = ['best-video-understanding-apis-2026', 'video-ai-landscape-2026'];
const featured = allEntries.filter((e) => FEATURED_SLUGS.includes(e.data.slug));
const rest = allEntries.filter((e) => !FEATURED_SLUGS.includes(e.data.slug));
---

<Base
  title="Compare"
  description="Honest, spec-table-driven comparisons of Primate Vision against every major video understanding API."
  canonicalPath="/compare"
  mdTwin="/compare.md"
>
  <div class="page">
    <section class="hero">
      <p class="eyebrow">Comparison Library</p>
      <h1>How Primate Vision compares</h1>
      <p class="lede">
        Honest, spec-table-driven comparisons against every major video understanding API.
        Every claim links to vendor docs. Failure modes printed where they exist.
      </p>
    </section>

    {featured.length > 0 && (
      <section class="featured-section">
        <h2 class="section-label">Start here</h2>
        <div class="featured-grid">
          {featured.map((post) => (
            <a class="featured-card" href={`/compare/${post.data.slug}`}>
              <div class="tags">
                {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <h3>{post.data.title}</h3>
              <p class="excerpt">{post.data.excerpt}</p>
              <div class="meta">
                <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
                <span>·</span>
                <span>{post.data.readTime}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="all-section">
      <h2 class="section-label">Head-to-head comparisons</h2>
      <div class="grid">
        {rest.map((post) => (
          <a class="card" href={`/compare/${post.data.slug}`}>
            {post.data.tags[0] && <span class="tag">{post.data.tags[0]}</span>}
            <h3>{post.data.title}</h3>
            <p class="excerpt">{post.data.excerpt}</p>
            <div class="meta">
              <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
              <span>·</span>
              <span>{post.data.readTime}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .page { max-width: 1120px; margin: 0 auto; padding: 128px 24px 192px; }
  .hero { text-align: center; margin-bottom: 112px; }
  .eyebrow {
    font-size: var(--fs-subhead);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 14px;
  }
  h1 { font-size: var(--fs-h1); font-weight: 700; letter-spacing: -0.02em; margin: 0 0 14px; }
  .lede { font-size: var(--fs-body); color: var(--color-text-muted); max-width: 560px; margin: 0 auto; line-height: 1.6; }

  .section-label {
    font-family: var(--font-mono);
    font-size: var(--fs-caption-1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 40px;
  }

  .featured-section { margin-bottom: 112px; }
  .featured-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px 24px; }
  .featured-card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 56px 28px;
    display: flex;
    flex-direction: column;
    color: inherit;
    position: relative;
  }
  .featured-card::before {
    content: 'Featured';
    position: absolute;
    top: -1px;
    right: 16px;
    font-size: var(--fs-caption-2);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--color-signal);
    color: #fff;
    padding: 3px 8px;
    border-radius: 0 0 4px 4px;
  }
  .featured-card:hover { border-color: rgba(27, 79, 224, 0.4); color: inherit; }

  .all-section { margin-top: 96px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 20px; }
  .card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    color: inherit;
  }
  .card:hover { border-color: rgba(27, 79, 224, 0.4); color: inherit; }

  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .tag {
    font-size: var(--fs-caption-1);
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--color-signal-subtle);
    color: var(--color-signal);
  }
  h3 { font-size: var(--fs-body-lg); font-weight: 600; line-height: 1.4; margin: 0 0 10px; }
  .excerpt {
    font-size: var(--fs-subhead);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 12px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-footnote);
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 980px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
    .featured-grid { grid-template-columns: 1fr; }
    h1 { font-size: var(--fs-h2); }
    .page { padding: 88px 20px 128px; }
  }
</style>
