---
/**
 * /technology — listing page for technology posts (PRI-516).
 *
 * Deliberately minimal: technology posts are data-driven pages (see
 * src/data/darwinPreview.ts), not a content collection — there's one post
 * today. If this section grows past ~3 posts, promote it to a proper
 * content collection mirroring src/content/blog.
 */
import Base from '../../layouts/Base.astro';
import { POST } from '../../data/darwinPreview';
import { formatDate } from '../../lib/blog';

const posts = [POST];
---

<Base
  title="Technology"
  description="How Primate Intelligence works — model releases, architecture notes, and capability updates from the team building real-time video intelligence."
  canonicalPath="/technology"
>
  <div class="page">
    <section class="hero">
      <p class="eyebrow">Under the Hood</p>
      <h1>Technology</h1>
      <p class="lede">Model releases, architecture notes, and capability updates from the team.</p>
    </section>

    <section class="posts">
      <div class="grid">
        {posts.map((post) => (
          <a class="card" href={`/technology/${post.slug}`}>
            <span class="tag">Model release</span>
            <h2>{post.title}</h2>
            <p class="excerpt">{post.excerpt}</p>
            <div class="meta">
              <time datetime={post.date}>{formatDate(post.date)}</time>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .page { max-width: 1120px; margin: 0 auto; padding: 64px 24px 96px; }
  .hero { text-align: center; margin-bottom: 56px; }
  .eyebrow {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 14px;
  }
  h1 { font-size: 44px; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 14px; }
  .lede { font-size: 16px; color: var(--color-text-muted); max-width: 480px; margin: 0 auto; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 28px;
    color: inherit;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }
  .card:hover { border-color: var(--color-signal); }
  .tag {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-signal-subtle);
    color: var(--color-signal);
  }
  h2 { font-size: 20px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.35; margin: 0; }
  .excerpt { font-size: 14px; color: var(--color-text-muted); line-height: 1.6; margin: 0; flex: 1; }
  .meta { font-size: 13px; color: var(--color-text-muted); }

  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
    h1 { font-size: 34px; }
    .page { padding: 44px 20px 64px; }
  }
</style>
