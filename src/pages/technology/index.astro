---
import Base from '../../layouts/Base.astro';
import ComingSoon from '../../components/ComingSoon.astro';

const subpages = [
  {
    href: '/technology/how-jepa-works',
    title: 'How JEPA works',
    desc: 'Joint-embedding predictive architecture — semantic understanding without a language model in the perception loop.',
  },
  {
    href: '/technology/determinism',
    title: 'Determinism',
    desc: 'Same input, same output, every time — why repeatability is the defining property for production video systems.',
  },
  {
    href: '/technology/benchmarks',
    title: 'Benchmarks',
    desc: 'What we measure, against which baselines, and honest failure modes.',
  },
  {
    href: '/technology/real-time',
    title: 'Real-time streaming',
    desc: 'WebRTC ingestion, per-GPU stream backends, and what "real-time" actually costs.',
  },
];
---

<Base
  title="Technology"
  description="Darwin is a JEPA-based predictive world model for video — fast, deterministic, and deployable at the edge. Learn how it works."
  canonicalPath="/technology"
  mdTwin="/technology.md"
>
  <div class="page">
    <section class="hero">
      <p class="eyebrow">Technology</p>
      <h1>World models, not video models</h1>
      <p class="lede">
        Primate Intelligence builds Darwin, a JEPA-based predictive world model for video.
      </p>
    </section>

    <section class="content">
      <p>
        Generative video models learn to render pixels; world models learn what happens next
        and why — the actual substrate of understanding. The difference is architectural.
        Generative models optimize for visual plausibility; world models optimize for
        predictive accuracy in representation space.
      </p>
      <p>
        Prediction in representation space — not pixel space — is what makes Darwin fast,
        deterministic, and deployable at the edge. There is no decoder generating hallucinated
        frames, no language model sampling stochastically at the perception layer. Just
        a model that watches video the way a systems engineer needs: deterministic,
        timestamped, confidence-scored, queryable in plain English.
      </p>

      <ComingSoon note="The full 'World models, not video models' essay is coming soon." />

      <h2>Explore the technology</h2>
      <div class="card-grid">
        {subpages.map((s) => (
          <a class="card" href={s.href}>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .page { max-width: 800px; margin: 0 auto; padding: 128px 24px 192px; }
  .hero { margin-bottom: 80px; }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-footnote);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-signal);
    margin: 0 0 12px;
  }
  h1 { font-size: var(--fs-h1); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin: 0 0 16px; }
  .lede { font-size: var(--fs-body-lg); color: var(--color-text-muted); line-height: 1.6; margin: 0; }
  .content p { font-size: var(--fs-body-lg); line-height: 1.75; color: var(--color-text-primary); opacity: 0.85; margin: 0 0 32px; }
  h2 { font-size: var(--fs-h3); font-weight: 600; letter-spacing: -0.015em; margin: 96px 0 40px; }

  .card-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 48px 24px;
    color: inherit;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .card:hover { border-color: rgba(27, 79, 224, 0.4); color: inherit; }
  .card h3 { font-size: var(--fs-body); font-weight: 600; margin: 0 0 8px; }
  .card p { font-size: var(--fs-subhead); color: var(--color-text-muted); line-height: 1.5; margin: 0; flex: 1; opacity: 1; }
  .arrow { position: absolute; bottom: 20px; right: 20px; color: var(--color-signal); font-size: var(--fs-body); }

  @media (max-width: 640px) {
    h1 { font-size: var(--fs-h2); }
    .card-grid { grid-template-columns: 1fr; }
    .page { padding: 88px 20px 128px; }
  }
</style>
