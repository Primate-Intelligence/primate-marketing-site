---
import Base from '../layouts/Base.astro';
---

<Base title="Real-time video intelligence" description="Primate Intelligence — real-time video intelligence for the physical world.">
  <section class="hero">
    <h1>Real-time video intelligence<br />for the physical world.</h1>
    <p class="lede">
      Point Primate Vision at any camera and ask questions in plain language.
      Live answers, structured data, and alerts — no training, no labeling.
    </p>
    <p class="cta-row">
      <a class="cta" href="https://primateintelligence.ai/">Try Primate Vision</a>
      <a class="cta secondary" href="/use-cases">See use cases</a>
    </p>
  </section>

  <section class="placeholder-note">
    <p><em>P0 scaffold — marketing site replatform in progress. Content placeholder.</em></p>
  </section>
</Base>

<style>
  .hero { padding: 48px 0; }
  h1 {
    font-size: 56px;
    line-height: 1.07;
    letter-spacing: -0.025em;
    font-weight: 700;
    margin: 0 0 24px;
  }
  .lede {
    font-size: 18px;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 560px;
  }
  .cta-row { display: flex; gap: 12px; margin-top: 32px; }
  .cta {
    display: inline-block;
    background: var(--color-signal);
    color: #fff;
    padding: 12px 24px;
    border-radius: var(--radius-lg);
    font-weight: 600;
    font-size: 15px;
    transition: background var(--duration-fast) var(--ease-standard);
  }
  .cta:hover { background: var(--color-signal-hover); color: #fff; }
  .cta.secondary {
    background: transparent;
    color: var(--color-signal);
    border: 1px solid var(--color-border);
  }
  .cta.secondary:hover { border-color: var(--color-signal); }
  .placeholder-note { margin-top: 64px; color: var(--color-text-muted); font-size: 13px; }
</style>
