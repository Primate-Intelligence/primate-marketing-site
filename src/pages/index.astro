---
import Base from '../layouts/Base.astro';
import Carousel from '../components/Carousel.astro';
import { APP_HREF } from '../lib/appUrl';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Primate Intelligence',
  url: 'https://primateintelligence.ai/',
};

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Primate Vision',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  description:
    'Real-time video intelligence API. Point Primate Vision at any camera or video and ask questions in plain language — deterministic answers, structured data, and live alerts with no training or labeling.',
  offers: {
    '@type': 'Offer',
    price: '0.01',
    priceCurrency: 'USD',
    description: '$0.01 per video second, metered credits. Free signup grant available.',
  },
  publisher: { '@type': 'Organization', name: 'Primate Intelligence' },
};

const codeSnippet = `# Get a key — no email, no card
curl -s -X POST https://api.primateintelligence.ai/v1/sandbox

# Ask a question about video
curl -s -X POST https://api.primateintelligence.ai/v1/analyses \\
  -H "Authorization: Bearer $PRIMATE_API_KEY" \\
  -H "Content-Type: application/json" \\
  -H "Prefer: wait=60" \\
  -d '{"video_id": "video_…", "prompt": "Is there a person in this video?"}'`;
---

<Base
  title="Real-time video intelligence"
  description="Watch Primate Vision understand video live. Point it at any camera, ask questions in plain language, and get deterministic answers — no training, no labeling."
  canonicalPath="/"
  jsonLd={[websiteLd, productLd]}
>
  <!-- ── Hero: watch it understand video live ── -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1>Watch it understand<br />video. Live.</h1>
        <p class="lede">
          Point Primate Vision at any camera and ask questions in plain language.
          Live answers, structured data, and alerts — no training, no labeling.
        </p>
        <p class="cta-row">
          <a class="cta" href={APP_HREF}>Try it live</a>
          <a class="cta secondary" href="/use-cases">See use cases</a>
        </p>
      </div>
      <div class="hero-video">
        <video
          src="/demos/chatgpt-plugin-demo.mp4"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          aria-label="Primate Vision analyzing video in real time"
        ></video>
      </div>
    </div>
  </section>

  <!-- ── Code snippet immediately below hero ── -->
  <section class="code-section">
    <div class="section-inner">
      <p class="section-eyebrow">For developers</p>
      <h2>First answer in one minute. No signup required.</h2>
      <pre><code>{codeSnippet}</code></pre>
      <p class="code-footnote">
        Full API docs at <a href="https://primateintelligence.ai/docs">primateintelligence.ai/docs</a> ·
        OpenAPI spec at <a href="https://api.primateintelligence.ai/v1/openapi.json">api.primateintelligence.ai</a>
      </p>
    </div>
  </section>

  <!-- ── Darwin carousel — migrated verbatim ── -->
  <section class="carousel-section">
    <div class="section-inner">
      <p class="section-eyebrow">Platform</p>
      <h2>One model. Every video workflow.</h2>
      <Carousel />
    </div>
  </section>

  <!-- ── Bottom CTA ── -->
  <section class="bottom-cta">
    <div class="section-inner center">
      <h2>Ready to test it on your footage?</h2>
      <p>Upload a short video. Ask a question. See the result in ~10 seconds.</p>
      <p class="cta-row center">
        <a class="cta" href={APP_HREF}>Try Primate Vision →</a>
        <a class="cta-link" href="https://cal.com/mattmiesnieks/customer-discovery">Talk to us about your use case →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--color-bg-primary);
    padding: 144px 24px 112px;
  }
  .hero-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 96px 48px;
    align-items: center;
  }
  h1 {
    font-size: var(--fs-display-l);
    line-height: 1.07;
    letter-spacing: -0.028em;
    font-weight: 800;
    margin: 0 0 20px;
  }
  .lede {
    font-size: var(--fs-body-lg);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0;
  }
  .cta-row { display: flex; gap: 14px; margin-top: 32px; align-items: center; flex-wrap: wrap; }
  .cta-row.center { justify-content: center; }
  .cta {
    display: inline-block;
    background: var(--color-signal);
    color: #fff;
    padding: 12px 26px;
    border-radius: var(--radius-lg);
    font-weight: 600;
    font-size: var(--fs-body);
    transition: background var(--duration-fast) var(--ease-standard);
  }
  .cta:hover { background: var(--color-signal-hover); color: #fff; }
  .cta.secondary {
    background: transparent;
    color: var(--color-signal);
    border: 1px solid var(--color-border);
  }
  .cta.secondary:hover { border-color: var(--color-signal); }
  .cta-link { color: var(--color-signal); font-weight: 500; font-size: var(--fs-body); }
  .hero-video video {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    display: block;
    background: #000;
  }

  .section-inner { max-width: 1120px; margin: 0 auto; }
  .section-inner.center { text-align: center; }
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-caption-1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-signal);
    margin: 0 0 20px;
  }
  h2 {
    font-size: var(--fs-h3);
    letter-spacing: -0.02em;
    font-weight: 700;
    margin: 0 0 48px;
  }

  .code-section {
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 112px 24px;
  }
  .code-section pre {
    background: #1a1916;
    color: #e6e9f4;
    border-radius: 8px;
    padding: 22px 24px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-subhead);
    line-height: 1.65;
    margin: 0;
  }
  .code-section pre code { background: none; padding: 0; color: inherit; font-size: inherit; }
  .code-footnote { font-size: var(--fs-subhead); color: var(--color-text-muted); margin: 14px 0 0; }

  .carousel-section { padding: 128px 24px; }

  .bottom-cta {
    border-top: 1px solid var(--color-border);
    padding: 144px 24px 176px;
  }
  .bottom-cta p { color: var(--color-text-muted); font-size: var(--fs-body); }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; gap: 32px; }
    h1 { font-size: var(--fs-h2); }
    h2 { font-size: var(--fs-h4); }
    .hero { padding: 80px 20px 80px; }
  }
</style>
