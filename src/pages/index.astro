---
// PRI-607: temporary stealth landing page. Replaces the normal homepage on
// primateintelligence.ai + www. only — static, no nav, no links, no CTA,
// no footer. Approved copy + visual spec locked in #marketing-guy
// 2026-10-30 (Matt: "1 is great, go with that"). Original homepage content
// lives in git history (this file, prior commits) — revert is a one-line
// `git revert` of the commit that introduced this page.
import '../styles/tokens.css';

const title = 'Primate Intelligence';
const description = 'Natural Intelligence for Robots — learners, not snapshots.';
const site = Astro.site ?? new URL('https://primateintelligence.ai');
const canonical = new URL('/', site).href;
const ogImageAbs = new URL('/Darwin_v3_vinyl_transparent.png', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/Darwin_v3_vinyl_transparent.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Primate Intelligence" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
  </head>
  <body>
    <main class="stealth">
      <div class="brand">
        <img src="/Darwin_v3_vinyl_transparent.png" alt="Primate Intelligence" width="56" height="56" />
        <span class="brand-text">
          <span class="brand-primate">Primate</span>
          <span class="brand-intelligence">Intelligence</span>
        </span>
      </div>
      <p class="tagline">Natural Intelligence for Robots — learners, not snapshots.</p>
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    height: 100%;
  }
  body {
    background: var(--color-bg-primary);
    font-family: var(--font-sans);
  }
  .stealth {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    padding: 24px;
    text-align: center;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-text-primary);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.12;
    font-size: var(--fs-h4);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .brand-primate {
    color: var(--color-text-primary);
  }
  .brand-intelligence {
    color: #2058f0;
  }
  .tagline {
    max-width: 640px;
    font-size: var(--fs-title-1);
    font-weight: 400;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.4;
  }
  @media (max-width: 480px) {
    .brand img {
      width: 44px;
      height: 44px;
    }
    .tagline {
      font-size: var(--fs-title-2);
    }
  }
</style>
