---
/**
 * Pricing — copy migrated verbatim from primate-intelligence-website-dev
 * src/pages/Pricing.tsx (PRI-437 metered-credits page). The SPA fetches live
 * config from GET /v1/credit-pricing; this static page renders the same launch
 * defaults the SPA falls back to (rate 1¢/s, $10/$25/$50/$100 presets, 600s
 * auto-refill threshold). Free-tier copy is frame-denominated (PRI-552) and
 * rendered from src/lib/pricingCopy.ts — never hand-type grant numbers here.
 */
import Base from '../layouts/Base.astro';
import { PRICING_FAQ, faqPageLd } from '../lib/faq';
import {
  GRANT_EQUIVALENCE_ROWS,
  FREE_TIER_HEADLINE,
  GRANT_FRAMES_LABEL,
  PRICE_PER_FRAME_USD_LABEL,
  PER_FRAME_30FPS_PER_HOUR_LABEL,
  PAID_RATE_EQUIVALENCE_ROWS,
  PREVIEW_PRICING_EYEBROW,
  PREVIEW_PRICING_FOOTNOTE,
} from '../lib/pricingCopy';

const presets = [1000, 2500, 5000, 10000];
const presetLabel = presets.map((c) => `$${c / 100}`).join(' · ');
// Frame-native refill math (PRI-552): frames = cents / price_per_frame_cents (0.00015¢).
const framesPerCent = 1 / 0.00015;
const fmtFrames = (c: number) => `${((c * framesPerCent) / 1_000_000).toLocaleString('en-US', { maximumFractionDigits: 1 })}M`;
const refillMath = presets.map((c) => `$${c / 100}≈${fmtFrames(c)} frames`).join(' · ');

const pricingLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Primate Vision',
  description: 'Metered video-intelligence credits. One balance for every video workflow.',
  // Google Merchant Center flagged "Missing field image" (first detected 8/2/26) —
  // schema.org Product requires an image. Canonical logo per the logo rule.
  image: 'https://primateintelligence.ai/Darwin_v3_vinyl_transparent.png',
  brand: { '@type': 'Brand', name: 'Primate Intelligence' },
  offers: [
    {
      '@type': 'Offer',
      name: 'Free Start',
      price: '0',
      priceCurrency: 'USD',
      description: `${GRANT_FRAMES_LABEL} signup grant (${FREE_TIER_HEADLINE.toLowerCase()}), no card required.`,
    },
    {
      '@type': 'Offer',
      name: 'Self-Serve',
      price: '0.0000015',
      priceCurrency: 'USD',
      description: `${PRICE_PER_FRAME_USD_LABEL} per processed frame, metered credits with auto-refill.`,
    },
  ],
};
---

<Base
  title="Pricing"
  description={`One balance for every video workflow. ${PRICE_PER_FRAME_USD_LABEL} per processed frame — buy credits once, use them through the web app, API, agents, file uploads, or live streams.`}
  canonicalPath="/pricing"
  jsonLd={[pricingLd, faqPageLd(PRICING_FAQ)]}
>
  <div class="page">
    <!-- ── Hero ── -->
    <section class="hero-grid">
      <div>
        <h1>One balance for every video workflow.</h1>
        <p class="lede">
          Buy video processing credits once. Use them through the web app, API, agents,
          file uploads, or live streams. You pay per frame actually processed — the
          slower your capture rate, the less you pay for the same coverage.
        </p>
      </div>
      <div class="rate-card">
        <p class="eyebrow">{PREVIEW_PRICING_EYEBROW} <span class="preview-pill">PREVIEW</span></p>
        <p class="rate"><span class="rate-num">{PRICE_PER_FRAME_USD_LABEL}</span> <span class="rate-unit">/ frame processed</span></p>
        <p class="muted small">
          ≈{PER_FRAME_30FPS_PER_HOUR_LABEL} per hour of 30 fps video. {PREVIEW_PRICING_FOOTNOTE}{' '}
          Live rate always at <code>GET /v1/credit-pricing</code>. Enterprise is custom.
        </p>
      </div>
    </section>

    <!-- ── Three cards ── -->
    <section class="cards">
      <div class="card">
        <p class="eyebrow">Free start</p>
        <h2>{FREE_TIER_HEADLINE}.</h2>
        <p class="big-num">{GRANT_FRAMES_LABEL}</p>
        <p class="muted small">
          Your free signup grant is a fixed frame budget — the slower your
          capture rate, the longer it lasts. Expires after 30 days. API keys
          are available immediately after account creation, no card required.
        </p>
        <table class="mini-table">
          <tbody>
            {GRANT_EQUIVALENCE_ROWS.map((r) => (
              <tr><td>{r.label}</td><td>{r.duration}</td></tr>
            ))}
          </tbody>
        </table>
        <a class="btn outline" href="https://primateintelligence.ai/signup">Create account</a>
      </div>

      <div class="card accent-signal">
        <p class="eyebrow">Self-serve</p>
        <h2>Metered credits for production work.</h2>
        <p class="big-num">{PRICE_PER_FRAME_USD_LABEL}<span class="rate-unit"> / frame</span></p>
        <p class="muted small">
          Billed per frame processed — replacing our per-second model. Buy credits
          manually or auto-refill when your balance runs low.
        </p>
        <table class="mini-table">
          <tbody>
            {PAID_RATE_EQUIVALENCE_ROWS.map((r) => (
              <tr><td>{r.label}</td><td>{r.cost}</td></tr>
            ))}
            <tr><td>Refill presets</td><td>{presetLabel}</td></tr>
            <tr><td>Paid credits</td><td>No expiry</td></tr>
          </tbody>
        </table>
        <a class="btn primary" href="https://primateintelligence.ai/signup">Buy credits</a>
      </div>

      <div class="card accent-green" id="enterprise">
        <p class="eyebrow">Enterprise</p>
        <h2>Custom pricing for committed volume.</h2>
        <p class="big-num">Talk to us</p>
        <p class="muted small">
          The metered rate is built for on-demand analysis — clips, incidents,
          agent-invoked checks. 24/7 monitoring and camera fleets run on enterprise
          plans: dedicated capacity, volume terms, and SLAs at committed-use rates.
        </p>
        <table class="mini-table">
          <tbody>
            <tr><td>Rate card</td><td>Custom</td></tr>
            <tr><td>Terms</td><td>Volume commit</td></tr>
            <tr><td>Support</td><td>SLA + dedicated</td></tr>
          </tbody>
        </table>
        <a class="btn outline" href="mailto:sales@primateintelligence.ai">Contact sales</a>
      </div>
    </section>

    <!-- ── Bottom panels ── -->
    <section class="panels">
      <div class="panel">
        <h3>How metering works</h3>
        <div class="steps">
          <div class="step">
            <div class="step-rule"></div>
            <p class="step-title">1. Upload or stream</p>
            <p class="muted small">We count the frames actually processed — your capture rate sets your cost.</p>
          </div>
          <div class="step">
            <div class="step-rule"></div>
            <p class="step-title">2. Reserve credits</p>
            <p class="muted small">Uploads reserve upfront. Streams reserve while live and reconcile at end.</p>
          </div>
          <div class="step">
            <div class="step-rule"></div>
            <p class="step-title">3. Settle ledger</p>
            <p class="muted small">Every event records job, source, frames, credit type, and balance — the API reports which rule billed it (<code>metering_rule</code>).</p>
          </div>
        </div>
      </div>
      <div class="panel">
        <h3>Fewer frames, smaller bill</h3>
        <div class="pills">
          <span class="pill signal">1 hour @ 30 fps ≈ 16¢</span>
          <span class="pill signal">1 hour @ 1 fps ≈ 0.5¢</span>
          <span class="pill green">You choose the capture rate</span>
          <span class="pill muted-pill">No queued-time charge</span>
          <span class="pill muted-pill">Failed jobs not charged</span>
        </div>
      </div>
    </section>

    <!-- ── FAQ (PRI-492: visible text mirrors the FAQPage JSON-LD exactly) ── -->
    <section class="faq">
      <h3>Frequently asked questions</h3>
      {PRICING_FAQ.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p class="muted small">{item.a}</p>
        </details>
      ))}
    </section>

    <!-- ── Footer strip ── -->
    <section class="footer-strip">
      <span>
        Refill math: {refillMath}. Enterprise:
        <a href="mailto:sales@primateintelligence.ai">sales@primateintelligence.ai</a>
      </span>
      <span>Paid credits never expire</span>
    </section>
  </div>
</Base>

<style>
  .page { max-width: 1120px; margin: 0 auto; padding: 128px 24px 160px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 96px 48px;
    align-items: center;
    margin-bottom: 96px;
  }
  h1 { font-size: var(--fs-h1); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin: 0; }
  .lede { font-size: var(--fs-body-lg); line-height: 1.6; color: var(--color-text-muted); margin: 16px 0 0; max-width: 560px; }
  .eyebrow {
    font-size: var(--fs-caption-1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a8a39a;
    margin: 0 0 12px;
  }
  .rate-card { background: var(--color-bg-secondary); border-radius: 10px; padding: 56px 28px; }
  /* PRI-554: preview-pricing pill — same treatment PRI-534 used for model status */
  .preview-pill {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-signal);
    background: var(--color-signal-subtle);
    border-radius: var(--radius-full);
    padding: 2px 10px;
    margin-left: 8px;
    vertical-align: middle;
  }
  .rate { margin: 0; }
  .rate-num { font-size: var(--fs-h3); font-weight: 800; letter-spacing: -0.02em; }
  .rate-unit { font-size: var(--fs-body-lg); font-weight: 400; color: var(--color-text-muted); }
  .muted { color: var(--color-text-muted); }
  .small { font-size: var(--fs-subhead); line-height: 1.6; }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 24px; margin-bottom: 64px; }
  .card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 56px 28px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .card h2 { font-size: var(--fs-body-lg); font-weight: 600; margin: 0 0 16px; line-height: 1.35; }
  .accent-signal::before, .accent-green::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
  }
  .accent-signal::before { background: var(--color-signal); }
  .accent-green::before { background: var(--color-success); }
  .big-num { font-size: var(--fs-display-s); font-weight: 800; letter-spacing: -0.03em; margin: 0 0 12px; }
  .mini-table { width: 100%; border-collapse: collapse; margin: auto 0 20px; }
  .mini-table td { padding: 10px 0; border-bottom: 1px solid var(--color-border); font-size: var(--fs-subhead); }
  .mini-table tr:first-child td { border-top: 1px solid var(--color-border); }
  .mini-table td:first-child { color: var(--color-text-muted); }
  .mini-table td:last-child { text-align: right; font-weight: 600; }
  .btn {
    font-size: var(--fs-body-sm);
    font-weight: 600;
    border-radius: 6px;
    padding: 10px 18px;
    text-align: center;
    display: block;
  }
  .btn.outline { color: var(--color-text-primary); background: var(--color-bg-surface); border: 1px solid var(--color-border); }
  .btn.primary { color: #fff; background: var(--color-signal); border: 1px solid var(--color-signal); }
  .btn.primary:hover { background: var(--color-signal-hover); color: #fff; }

  .panels { display: grid; grid-template-columns: 3fr 2fr; gap: 48px 24px; margin-bottom: 80px; }
  .panel { background: var(--color-bg-secondary); border-radius: 10px; padding: 56px 28px; }
  .panel h3 { font-size: var(--fs-body-lg); font-weight: 700; margin: 0 0 40px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .step-rule { width: 32px; height: 2px; background: var(--color-text-primary); margin-bottom: 12px; }
  .step-title { font-size: var(--fs-body-sm); font-weight: 600; margin: 0 0 6px; }
  .pills { display: flex; flex-wrap: wrap; gap: 10px; }
  .pill {
    font-size: var(--fs-subhead);
    font-weight: 500;
    border-radius: 999px;
    padding: 6px 12px;
    white-space: nowrap;
    border: 1px solid;
  }
  .pill.signal { color: var(--color-signal); border-color: rgba(27, 79, 224, 0.33); }
  .pill.green { color: var(--color-success); border-color: rgba(22, 163, 74, 0.33); }
  .pill.muted-pill { color: var(--color-text-muted); border-color: rgba(122, 118, 105, 0.33); }

  .faq { margin-bottom: 80px; }
  .faq h3 { font-size: var(--fs-body-lg); font-weight: 700; margin: 0 0 32px; }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    padding: 8px 0;
  }
  .faq-item summary {
    font-size: var(--fs-body);
    font-weight: 600;
    padding: 12px 0;
    cursor: pointer;
    list-style-position: outside;
  }
  .faq-item p { margin: 0 0 32px; max-width: 760px; }

  .footer-strip {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    border-top: 1px solid var(--color-border);
    padding-top: 40px;
    font-size: var(--fs-footnote);
    color: #a8a39a;
    flex-wrap: wrap;
  }
  .footer-strip a { color: #a8a39a; text-decoration: underline; }

  @media (max-width: 860px) {
    .hero-grid, .cards, .panels, .steps { grid-template-columns: 1fr; }
    h1 { font-size: var(--fs-h2); }
    .page { padding: 80px 20px 120px; }
  }
</style>
