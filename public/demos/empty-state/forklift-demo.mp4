<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Real-time video intelligence API. Deterministic results. Edge deployment. No hallucinations." />
    <meta name="theme-color" content="#0C0D10" />
    <meta name="theme-color" content="#F5F5F0" media="(prefers-color-scheme: light)" />
    <link rel="alternate" type="text/markdown" title="Primate Vision API docs for agents" href="/llms.txt" />
    <link rel="alternate" type="text/markdown" title="Primate Vision full docs corpus" href="/llms-full.txt" />
    <link rel="help" type="text/markdown" title="Quickstart for AI agents" href="/docs/agents.md" />
    <link rel="service-desc" type="application/json" title="Primate Vision OpenAPI" href="https://api.dev.primateintelligence.ai/v1/openapi.json" />

    <!-- Open Graph / Social preview -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.primateintelligence.ai/" />
    <meta property="og:title" content="Primate Vision — Real-Time Video Intelligence API" />
    <meta property="og:description" content="Real-time video intelligence API. Deterministic results. Edge deployment. No hallucinations." />
    <meta property="og:site_name" content="Primate Intelligence" />
    <meta property="og:image" content="https://www.primateintelligence.ai/Darwin_v3_vinyl_transparent.png" />

    <!-- Twitter / Discord unfurl -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Primate Vision — Real-Time Video Intelligence API" />
    <meta name="twitter:description" content="Real-time video intelligence API. Deterministic results. Edge deployment. No hallucinations." />
    <meta name="twitter:image" content="https://www.primateintelligence.ai/Darwin_v3_vinyl_transparent.png" />

    <!-- Fonts: Inter (sans) + JetBrains Mono (mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Caveat:wght@500;600;700&display=swap" rel="stylesheet" />

    <title>Primate Vision — Real-Time Video Intelligence API</title>
    <!-- Apply saved theme before React mounts to avoid flash-of-dark-mode -->
    <script>
      (function(){
        try{
          var t=localStorage.getItem('primate-theme')||'light';
          if(t==='auto') t=window.matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';
          document.documentElement.setAttribute('data-theme',t);
        }catch(e){}
      })();
    </script>

    <!-- Preload the EmptyStateDemo fixture so it's in cache by the time
         the React tree hydrates + the demo mounts. Eliminates the
         ~50-200ms blank-frame gap between auth-resolves and demo-paints
         that Matt flagged 2026-05-26 18:44 (#engineering-jeff). Tiny
         (~1.8KB) and only fetched on the workspace surface anyway. -->
    <link rel="preload" href="/empty-state/demo-session.json" as="fetch" crossorigin="anonymous" />
    <script type="module" crossorigin src="/assets/index-C2kLFPMs.js"></script>
    <link rel="modulepreload" crossorigin href="/assets/ffmpeg-DToQC1OH.js">
    <link rel="stylesheet" crossorigin href="/assets/index-XfoxTXWV.css">
  </head>
  <body class="antialiased">
    <noscript>
      <nav aria-label="Primate Vision API documentation">
        <a href="/llms.txt">API docs for agents</a>
        <a href="/llms-full.txt">Full docs corpus</a>
        <a href="/docs/agents.md">Quickstart for AI agents</a>
        <a href="https://api.dev.primateintelligence.ai/v1/openapi.json">OpenAPI schema</a>
      </nav>
    </noscript>
    <div id="root"></div>
  </body>
</html>
